<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <pipeline_type>Normal</pipeline_type>
    <name>pl_dim_admision</name>
    <description>Pipeline ETL para poblar la dimension de modalidades de admision (examen)</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>EXT - Modalidades de Admision</name>
    <description>Extrae el catalogo de los tipos de examen e ingreso</description>
    <sql>SELECT 
    TRIM(id_examen::VARCHAR) AS id_examen,
    COALESCE(TRIM(examen::VARCHAR), 'NO DEFINIDO') AS modalidad_ingreso
FROM public.prs_examen;</sql>
    <connection>OLTP db</connection>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <type>StringOperations</type>
    <name>TRF - Estandarizar Textos</name>
    <description>Aplica TRIM y convierte a mayusculas (Data Quality)</description>
    <fields>
      <field><in_stream_name>modalidad_ingreso</in_stream_name><trim_type>both</trim_type><lower_upper>upper</lower_upper></field>
    </fields>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>LOD - dim_admision</name>
    <description>Upsert en el DW (SCD Tipo 1)</description>
    <connection>DSS DW</connection>
    <commit>1000</commit>
    <lookup>
      <schema>public</schema>
      <table>dim_admision</table>
      <key>
        <name>id_examen</name>
        <field>id_examen</field>
        <condition>=</condition>
      </key>
      <value><name>id_examen</name><rename>id_examen</rename><update>N</update></value>
      <value><name>modalidad_ingreso</name><rename>modalidad_ingreso</rename><update>Y</update></value>
    </lookup>
    <GUI>
      <xloc>544</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <order>
    <hop>
      <from>EXT - Modalidades de Admision</from>
      <to>TRF - Estandarizar Textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>TRF - Estandarizar Textos</from>
      <to>LOD - dim_admision</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</pipeline>
