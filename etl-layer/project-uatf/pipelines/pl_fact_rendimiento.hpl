<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <pipeline_type>Normal</pipeline_type>
    <name>pl_fact_rendimiento</name>
    <description>Pipeline ETL para cargar la Tabla de Hechos de Rendimiento y Desercion Estudiantil</description>
  </info>
  
  <transform>
    <type>TableInput</type>
    <name>EXT - Rendimiento y Notas</name>
    <description>Extrae la transaccion base cruzando notas, estudiantes y postulacion</description>
    <sql>SELECT 
    -- 1. LLaves Naturales
    TRIM(np.id_alumno::VARCHAR) AS id_estudiante_nk,
    TRIM(a.id_programa) AS id_programa_nk,
    TRIM(np.id_materia::VARCHAR) AS id_materia_nk,
    np.id_gestion::INTEGER AS id_gestion_nk,
    np.id_periodo::INTEGER AS id_periodo_nk,
    COALESCE(TRIM(pos.examen::VARCHAR), '0') AS id_admision_nk,

    -- 2. Metricas Base de Hechos
    np.nota AS nota_final,
    
    -- 3. Reglas de Negocio / Indicadores Derivados
    CASE WHEN np.nota &lt; 51 THEN 1 ELSE 0 END AS reprobado,
    CASE WHEN pos.id_alumno IS NOT NULL THEN 1 ELSE 0 END AS postulante,
    CASE WHEN pos.estado IN ('A', 'I') THEN 1 ELSE 0 END AS admitido,
    0 AS repitente, -- Se actualizará luego o en modelo avanzado
    0 AS desertor -- Calculado por ML posteriormente
    
FROM academico.notas_planilla np
JOIN academico.alumnos a ON a.id_alumno = np.id_alumno
LEFT JOIN public.postulantes pos ON pos.id_alumno = a.id_alumno
WHERE np.id_gestion IS NOT NULL</sql>
    <connection>OLTP db</connection>
    <GUI><xloc>64</xloc><yloc>96</yloc></GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_estudiante</name>
    <description>Rescata el SK de la dimensión Estudiante</description>
    <connection>DSS DW</connection>
    <cache>Y</cache>
    <cache_size>10000</cache_size>
    <lookup>
      <schema>public</schema>
      <table>dim_estudiante</table>
      <key><name>id_estudiante_nk</name><field>id_alumno</field><condition>=</condition></key>
      <value><name>id_estudiante_sk</name><rename>id_estudiante_sk</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>256</xloc><yloc>96</yloc></GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_programa</name>
    <description>Rescata el SK de la dimensión Programa</description>
    <connection>DSS DW</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <lookup>
      <schema>public</schema>
      <table>dim_programa</table>
      <key><name>id_programa_nk</name><field>id_programa</field><condition>=</condition></key>
      <value><name>id_programa_sk</name><rename>id_programa_sk</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>416</xloc><yloc>96</yloc></GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_materia</name>
    <description>Rescata el SK de la dimensión Materia</description>
    <connection>DSS DW</connection>
    <cache>Y</cache>
    <cache_size>5000</cache_size>
    <lookup>
      <schema>public</schema>
      <table>dim_materia</table>
      <key><name>id_materia_nk</name><field>id_materia</field><condition>=</condition></key>
      <value><name>id_materia_sk</name><rename>id_materia_sk</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>576</xloc><yloc>96</yloc></GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_periodo</name>
    <description>Rescata el SK de la dimensión Periodo</description>
    <connection>DSS DW</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <lookup>
      <schema>public</schema>
      <table>dim_periodo_academico</table>
      <key><name>id_gestion_nk</name><field>gestion</field><condition>=</condition></key>
      <key><name>id_periodo_nk</name><field>periodo</field><condition>=</condition></key>
      <value><name>id_periodo_sk</name><rename>id_periodo_sk</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>736</xloc><yloc>96</yloc></GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_admision</name>
    <description>Rescata el SK de la dimensión Admision</description>
    <connection>DSS DW</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <lookup>
      <schema>public</schema>
      <table>dim_admision</table>
      <key><name>id_admision_nk</name><field>id_examen</field><condition>=</condition></key>
      <value><name>id_admision_sk</name><rename>id_admision_sk</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>896</xloc><yloc>96</yloc></GUI>
  </transform>

  <transform>
    <type>InsertUpdate</type>
    <name>LOD - fact_rendimiento_academico</name>
    <description>Carga idempotente a la Tabla de Hechos (UPSERT para evitar duplicados masivos)</description>
    <connection>DSS DW</connection>
    <commit>5000</commit>
    <lookup>
      <schema>public</schema>
      <table>fact_rendimiento_academico</table>
      <key><name>id_estudiante_sk</name><field>id_estudiante_sk</field><condition>=</condition></key>
      <key><name>id_programa_sk</name><field>id_programa_sk</field><condition>=</condition></key>
      <key><name>id_materia_sk</name><field>id_materia_sk</field><condition>=</condition></key>
      <key><name>id_periodo_sk</name><field>id_periodo_sk</field><condition>=</condition></key>
      <key><name>id_admision_sk</name><field>id_admision_sk</field><condition>=</condition></key>
      
      <value><name>id_estudiante_sk</name><rename>id_estudiante_sk</rename><update>N</update></value>
      <value><name>id_programa_sk</name><rename>id_programa_sk</rename><update>N</update></value>
      <value><name>id_materia_sk</name><rename>id_materia_sk</rename><update>N</update></value>
      <value><name>id_periodo_sk</name><rename>id_periodo_sk</rename><update>N</update></value>
      <value><name>id_admision_sk</name><rename>id_admision_sk</rename><update>N</update></value>
      
      <value><name>postulante</name><rename>postulante</rename><update>Y</update></value>
      <value><name>admitido</name><rename>admitido</rename><update>Y</update></value>
      <value><name>nota_final</name><rename>nota_final</rename><update>Y</update></value>
      <value><name>reprobado</name><rename>reprobado</rename><update>Y</update></value>
      <value><name>repitente</name><rename>repitente</rename><update>Y</update></value>
      <value><name>desertor</name><rename>desertor</rename><update>Y</update></value>
    </lookup>
    <GUI><xloc>1056</xloc><yloc>96</yloc></GUI>
  </transform>

  <order>
    <hop><from>EXT - Rendimiento y Notas</from><to>LKP - dim_estudiante</to><enabled>Y</enabled></hop>
    <hop><from>LKP - dim_estudiante</from><to>LKP - dim_programa</to><enabled>Y</enabled></hop>
    <hop><from>LKP - dim_programa</from><to>LKP - dim_materia</to><enabled>Y</enabled></hop>
    <hop><from>LKP - dim_materia</from><to>LKP - dim_periodo</to><enabled>Y</enabled></hop>
    <hop><from>LKP - dim_periodo</from><to>LKP - dim_admision</to><enabled>Y</enabled></hop>
    <hop><from>LKP - dim_admision</from><to>LOD - fact_rendimiento_academico</to><enabled>Y</enabled></hop>
  </order>
</pipeline>
