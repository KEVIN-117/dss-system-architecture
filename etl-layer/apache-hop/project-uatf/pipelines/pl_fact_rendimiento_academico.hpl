<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <pipeline_type>Normal</pipeline_type>
    <name>pl_fact_rendimiento_academico</name>
    <description>Pipeline para poblar la tabla de hechos de rendimiento academico</description>
  </info>
  
  <transform>
    <type>TableInput</type>
    <name>EXT - Notas Planilla</name>
    <description>Extraccion de notas y calculo de banderas basicas (reprobado, admitido)</description>
    <sql>SELECT 
    np.id_alumno,
    a.id_programa,
    np.id_materia,
    np.id_gestion,
    np.id_periodo,
    COALESCE(p.id_examen, 0) AS id_examen,
    np.nota AS nota_final,
    CASE WHEN np.nota &lt; 51 THEN 1 ELSE 0 END AS reprobado,
    0 AS repitente, 
    0 AS desertor, 
    0.0 AS probabilidad_riesgo,
    0 AS alto_riesgo,
    0 AS indice_dependencia,
    0 AS demanda_proyectada,
    0.0 AS importancia_variable,
    0 AS postulante,
    1 AS admitido
FROM academico.notas_planilla np
INNER JOIN academico.alumnos a ON np.id_alumno = a.id_alumno
LEFT JOIN public.postulantes p ON a.id_ra = a.id_ra
WHERE np.id_gestion &gt;= 2020</sql>
    <connection>DSS_TRANSACTIONAL</connection>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_estudiante</name>
    <description>Busca el surrogate key del estudiante</description>
    <connection>DSS_WAREHOUSE</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_estudiante</table>
      <key>
        <name>id_alumno</name>
        <field>id_alumno</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_estudiante_sk</name>
        <rename>id_estudiante_sk</rename>
        <default>-1</default>
        <type>Integer</type>
      </value>
    </lookup>
    <GUI>
      <xloc>256</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_programa</name>
    <description>Busca el surrogate key del programa academico</description>
    <connection>DSS_WAREHOUSE</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_programa</table>
      <key>
        <name>id_programa</name>
        <field>id_programa</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_programa_sk</name>
        <rename>id_programa_sk</rename>
        <default>-1</default>
        <type>Integer</type>
      </value>
    </lookup>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_materia</name>
    <description>Busca el surrogate key de la materia</description>
    <connection>DSS_WAREHOUSE</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_materia</table>
      <key>
        <name>id_materia</name>
        <field>id_materia</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_materia_sk</name>
        <rename>id_materia_sk</rename>
        <default>-1</default>
        <type>Integer</type>
      </value>
    </lookup>
    <GUI>
      <xloc>576</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <transform>
    <type>DBLookup</type>
    <name>LKP - dim_periodo</name>
    <description>Busca el surrogate key del periodo academico</description>
    <connection>DSS_WAREHOUSE</connection>
    <lookup>
      <schema>public</schema>
      <table>dim_periodo_academico</table>
      <key>
        <name>id_gestion</name>
        <field>gestion</field>
        <condition>=</condition>
      </key>
      <key>
        <name>id_periodo</name>
        <field>periodo</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_periodo_sk</name>
        <rename>id_periodo_sk</rename>
        <default>-1</default>
        <type>Integer</type>
      </value>
    </lookup>
    <GUI>
      <xloc>736</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <transform>
    <type>TableOutput</type>
    <name>LOD - fact_rendimiento_academico</name>
    <description>Carga masiva en la tabla de hechos usando Table Output</description>
    <connection>DSS_WAREHOUSE</connection>
    <commit>5000</commit>
    <schema>public</schema>
    <table>fact_rendimiento_academico</table>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><column_name>id_estudiante_sk</column_name><stream_name>id_estudiante_sk</stream_name></field>
      <field><column_name>id_programa_sk</column_name><stream_name>id_programa_sk</stream_name></field>
      <field><column_name>id_materia_sk</column_name><stream_name>id_materia_sk</stream_name></field>
      <field><column_name>id_periodo_sk</column_name><stream_name>id_periodo_sk</stream_name></field>
      <field><column_name>nota_final</column_name><stream_name>nota_final</stream_name></field>
      <field><column_name>reprobado</column_name><stream_name>reprobado</stream_name></field>
      <field><column_name>repitente</column_name><stream_name>repitente</stream_name></field>
      <field><column_name>desertor</column_name><stream_name>desertor</stream_name></field>
      <field><column_name>probabilidad_riesgo</column_name><stream_name>probabilidad_riesgo</stream_name></field>
      <field><column_name>alto_riesgo</column_name><stream_name>alto_riesgo</stream_name></field>
      <field><column_name>indice_dependencia</column_name><stream_name>indice_dependencia</stream_name></field>
      <field><column_name>demanda_proyectada</column_name><stream_name>demanda_proyectada</stream_name></field>
      <field><column_name>importancia_variable</column_name><stream_name>importancia_variable</stream_name></field>
      <field><column_name>postulante</column_name><stream_name>postulante</stream_name></field>
      <field><column_name>admitido</column_name><stream_name>admitido</stream_name></field>
    </fields>
    <GUI>
      <xloc>896</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <order>
    <hop>
      <from>EXT - Notas Planilla</from>
      <to>LKP - dim_estudiante</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>LKP - dim_estudiante</from>
      <to>LKP - dim_programa</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>LKP - dim_programa</from>
      <to>LKP - dim_materia</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>LKP - dim_materia</from>
      <to>LKP - dim_periodo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>LKP - dim_periodo</from>
      <to>LOD - fact_rendimiento_academico</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</pipeline>
