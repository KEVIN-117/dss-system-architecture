<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <pipeline_type>Normal</pipeline_type>
    <name>pl_dim_materia</name>
    <description>Pipeline ETL para poblar la dimension de materias/asignaturas</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>EXT - Materias</name>
    <description>Extrae el catalogo de asignaturas de la malla curricular</description>
    <sql>SELECT 
    TRIM(id_materia::VARCHAR) AS id_materia,
    COALESCE(TRIM(sigla::VARCHAR), 'ND') AS sigla,
    COALESCE(TRIM(materia::VARCHAR), 'NO DEFINIDO') AS nombre_materia
FROM academico.pln_materias;</sql>
    <connection>OLTP db</connection>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <type>StringOperations</type>
    <name>TRF - Estandarizar Textos</name>
    <description>Aplica TRIM y convierte a mayusculas (Data Quality)</description>
    <fields>
      <field><in_stream_name>sigla</in_stream_name><trim_type>both</trim_type><lower_upper>upper</lower_upper></field>
      <field><in_stream_name>nombre_materia</in_stream_name><trim_type>both</trim_type><lower_upper>upper</lower_upper></field>
    </fields>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>LOD - dim_materia</name>
    <description>Upsert en el DW (SCD Tipo 1)</description>
    <connection>DSS DW</connection>
    <commit>1000</commit>
    <lookup>
      <schema>public</schema>
      <table>dim_materia</table>
      <key>
        <name>id_materia</name>
        <field>id_materia</field>
        <condition>=</condition>
      </key>
      <value><name>id_materia</name><rename>id_materia</rename><update>N</update></value>
      <value><name>sigla</name><rename>sigla</rename><update>Y</update></value>
      <value><name>nombre_materia</name><rename>nombre_materia</rename><update>Y</update></value>
    </lookup>
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <order>
    <hop>
      <from>EXT - Materias</from>
      <to>TRF - Estandarizar Textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>TRF - Estandarizar Textos</from>
      <to>LOD - dim_materia</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</pipeline>
