<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>pl_dim_programa</name>
    <name_sync_with_filename>N</name_sync_with_filename>
    <description>Pipeline ETL para poblar la dimension de programas y facultades</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/08/24 18:58:18.225</created_date>
    <modified_date>2026/08/24 18:58:18.225</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>EXT - Programas y Facultades</name>
    <sql>SELECT
        TRIM(p.id_programa) AS id_programa,
        TRIM(p.programa) AS carrera,
        COALESCE(TRIM(f.facultad), 'ND') AS facultad,
        COALESCE(TRIM(f.facu_abre), 'ND') AS facultad_abrev,
        'Desconocido' AS area_conocimiento
FROM academico.alm_programas p
LEFT JOIN academico.alm_programas_facultades f
    ON p.id_facultad = f.id_facultad</sql>
    <limit/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>OLTP db</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Extrae TODAS las carreras (incluyendo inactivas) de Jachasun.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>IfNull</type>
    <name>TRF - Manejo de Nulos</name>
    <fields>
      <field>
        <name>facultad_abrev</name>
        <value>ND</value>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>area_conocimiento</name>
        <value>Desconocido</value>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <valuetypes/>
    <selectFields>Y</selectFields>
    <selectValuesType>N</selectValuesType>
    <setEmptyStringAll>N</setEmptyStringAll>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Reemplaza campos nulos con valores por defecto (ND).</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>StringOperations</type>
    <name>TRF - Estandarizar Textos</name>
    <fields>
      <field>
        <in_stream_name>carrera</in_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>facultad</in_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
      <field>
        <in_stream_name>facultad_abrev</in_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Aplica TRIM y convierte a mayúsculas.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>LOD - dim_programa</name>
    <lookup>
      <key>
        <name>id_programa</name>
        <field>id_programa</field>
        <condition>=</condition>
      </key>
      <value>
        <name>id_programa</name>
        <rename>id_programa</rename>
        <update>N</update>
      </value>
      <value>
        <name>carrera</name>
        <rename>carrera</rename>
        <update>Y</update>
      </value>
      <value>
        <name>facultad</name>
        <rename>facultad</rename>
        <update>Y</update>
      </value>
      <value>
        <name>facultad_abrev</name>
        <rename>facultad_abrev</rename>
        <update>Y</update>
      </value>
      <value>
        <name>area_conocimiento</name>
        <rename>area_conocimiento</rename>
        <update>Y</update>
      </value>
      <schema>public</schema>
      <table>dim_programa</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>DSS DW</connection>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>672</xloc>
      <yloc>96</yloc>
    </GUI>
    <description>Upsert en el Data Warehouse basándose en id_programa.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>EXT - Programas y Facultades</from>
      <to>TRF - Manejo de Nulos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>TRF - Manejo de Nulos</from>
      <to>TRF - Estandarizar Textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>TRF - Estandarizar Textos</from>
      <to>LOD - dim_programa</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
