<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>main_orchestrator</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Entrada DW-012: verifica el bundle RAW completo y lee los nueve conjuntos JSONL.</description>
  <extended_description>Este workflow exige RUN_ID, ejecuta raw-verify antes de abrir artefactos y detiene la ejecución ante cualquier fallo. Esta fase solo ingiere/lee RAW; no publica dimensiones ni hechos.</extended_description>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/10/02 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/02 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>RUN_ID</name>
      <default_value/>
      <description>UUID del snapshot completo generado por Load Manager.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name><description/><type>SPECIAL</type><attributes/><DayOfMonth>1</DayOfMonth><hour>12</hour><intervalMinutes>60</intervalMinutes><intervalSeconds>0</intervalSeconds><minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay><parallel>N</parallel><xloc>64</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>Preflight RAW bundle</name>
      <description>Verifica los nueve manifiestos, artefactos, tamaños, SHA-256, gzip, JSONL y conteos con el principal read-only.</description>
      <type>SHELL</type><attributes/>
      <filename>/usr/local/bin/verify-raw-bundle.sh</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous><exec_per_row>N</exec_per_row><set_logfile>N</set_logfile><logfile/><set_append_logfile>N</set_append_logfile><logext/><add_date>N</add_date><add_time>N</add_time><insertScript>N</insertScript><script/>
      <arguments><argument><value>${RUN_ID}</value><hidden>N</hidden></argument></arguments>
      <loglevel>Basic</loglevel><parallel>N</parallel><xloc>256</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>Read verified RAW JSONL</name><description>Lee/descomprime las nueve colecciones sin registrar filas ni cargar tablas dimensionales.</description><type>PIPELINE</type><attributes/>
      <filename>${PROJECT_HOME}/pipelines/pl_read_raw_bundle.hpl</filename>
      <run_configuration>local</run_configuration>
      <add_date>N</add_date><add_time>N</add_time><clear_files>N</clear_files><clear_rows>N</clear_rows><create_parent_folder>N</create_parent_folder><exec_per_row>N</exec_per_row><logext/><logfile/><loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><parallel>N</parallel><xloc>480</xloc><yloc>96</yloc><attributes_hac/>
    </action>
    <action>
      <name>Abort on RAW error</name><description>No se inicia la lectura si falla el preflight o el lector gzip.</description><type>ABORT</type><attributes/><always_log_rows>N</always_log_rows><parallel>N</parallel><xloc>368</xloc><yloc>208</yloc><attributes_hac/>
    </action>
    <action>
      <name>Success</name><description>RAW bundle verificado y leído por Hop.</description><type>SUCCESS</type><attributes/><parallel>N</parallel><xloc>688</xloc><yloc>96</yloc><attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Preflight RAW bundle</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Preflight RAW bundle</from><to>Read verified RAW JSONL</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Preflight RAW bundle</from><to>Abort on RAW error</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Read verified RAW JSONL</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Read verified RAW JSONL</from><to>Abort on RAW error</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
