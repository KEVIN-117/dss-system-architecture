<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_hop_publish_staged_run</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Publica un conjunto preparado usando lease, fencing token y transacción atómica</description>
    <extended_description>La adquisición del lease, el gate de nueve manifiestos, el cambio a PUBLICANDO, la sustitución del corte y la transición EXITOSA ocurren en una única sentencia PostgreSQL. Si falla, toda la sentencia revierte y el workflow ejecuta la ruta de auditoría FALLIDA. No se escriben filas de negocio fuera de etl_work.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters><parameter><name>P_RUN_ID</name><default_value/><description>UUID nuevo que contiene ocho lotes sellados</description></parameter></parameters>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user><created_date>2026/10/04 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/04 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order><hop><from>Get run ID</from><to>Fenced atomic publish</to><enabled>Y</enabled></hop><hop><from>Fenced atomic publish</from><to>Published</to><enabled>Y</enabled></hop></order>
  <transform>
    <name>Get run ID</name><type>GetVariable</type><description>El UUID se enlaza mediante parámetro JDBC</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field></fields><attributes/><GUI><xloc>128</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Fenced atomic publish</name><type>TableInput</type><description>La función SECURITY DEFINER es el único escritor DW; el token se comprueba dentro de la misma transacción que sustituye la publicación</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <connection>DSS DW</connection>
    <sql>WITH request AS MATERIALIZED (
    SELECT ?::uuid AS run_id
), lease AS MATERIALIZED (
    SELECT request.run_id,
           (etl_control.acquire_hop_publication_lock(request.run_id, 900)).lock_token AS lock_token
    FROM request
), publishing AS MATERIALIZED (
    SELECT lease.run_id, lease.lock_token,
           (etl_control.begin_hop_publication(
               lease.run_id, lease.lock_token,
               'Hop: manifiestos y ocho lotes preparados aprobados'::text
           )).run_id AS publishing_run_id
    FROM lease
), published AS MATERIALIZED (
    SELECT (etl_control.publish_hop_staged_run(
        publishing.run_id, publishing.lock_token,
        'Hop: publicación atómica del conjunto validado'::text
    )).run_id AS run_id
    FROM publishing
)
SELECT run_id FROM published;</sql>
    <limit>0</limit><lookup>Get run ID</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>432</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform><name>Published</name><type>Dummy</type><description>Solo se alcanza después del commit de publicación EXITOSA</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>752</xloc><yloc>160</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>
