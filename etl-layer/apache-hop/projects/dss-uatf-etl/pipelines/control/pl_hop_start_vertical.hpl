<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_hop_start_vertical</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Preflight y apertura de una ejecución asociada al cierre DSA solicitado</description>
    <extended_description>P_RUN_ID, P_REQUESTED_GESTION y P_REQUESTED_PERIODO identifican el intento y cierre. Todo se enlaza como parámetros JDBC preparados.</extended_description>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>P_RUN_ID</name>
        <default_value/>
        <description>UUID único para este intento</description>
      </parameter>
      <parameter><name>P_REQUESTED_GESTION</name><default_value/><description>Gestión del cierre autorizado</description></parameter>
      <parameter><name>P_REQUESTED_PERIODO</name><default_value/><description>Código de periodo del cierre autorizado</description></parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user>
    <created_date>2026/10/03 00:00:00.000</created_date>
    <modified_user>DSA</modified_user>
    <modified_date>2026/10/03 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Get run ID</from><to>Create and start run</to><enabled>Y</enabled></hop>
    <hop><from>Create and start run</from><to>Run initialized</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Get run ID</name>
    <type>GetVariable</type>
    <description>Obtiene el UUID de la solicitud sin interpolarlo dentro del SQL</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
    <field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field>
    <field><currency/><decimal/><format/><group/><length>4</length><name>gestion</name><precision>0</precision><trim_type>both</trim_type><type>Integer</type><variable>${P_REQUESTED_GESTION}</variable></field>
    <field><currency/><decimal/><format/><group/><length>2</length><name>periodo</name><precision>0</precision><trim_type>both</trim_type><type>Integer</type><variable>${P_REQUESTED_PERIODO}</variable></field>
    </fields>
    <attributes/>
    <GUI><xloc>128</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Create and start run</name>
    <type>TableInput</type>
    <description>Las dos transiciones comparten una sentencia y un parámetro JDBC preparado</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DSS DW</connection>
    <sql>WITH params AS MATERIALIZED (
    SELECT ?::uuid AS run_id, ?::smallint AS gestion, ?::smallint AS periodo
), closure AS MATERIALIZED (
    SELECT c.closure_id, c.gestion, c.periodo, c.effective_at
    FROM etl_control.academic_period_closure c CROSS JOIN params p
    WHERE c.gestion = p.gestion AND c.periodo = p.periodo AND c.status = 'CERRADO'
), created AS MATERIALIZED (
    SELECT (etl_control.create_hop_etl_execution(
        params.run_id, 'CIERRE_ACADEMICO'::varchar(24), closure.closure_id, closure.gestion,
        closure.periodo, closure.effective_at, NULL::uuid,
        'Ejecución Hop vertical por cierre académico solicitado'::text
    )).run_id AS run_id
    -- LEFT JOIN deliberately calls the preflight function even when there is no
    -- eligible closure. Passing NULL makes create_hop_etl_execution reject the
    -- request instead of silently returning zero rows and letting extraction run.
    FROM params LEFT JOIN closure ON TRUE
), started AS MATERIALIZED (
    SELECT (etl_control.start_hop_etl_execution(
        created.run_id, 'Preflight aprobado; inicia extracción vertical'::text
    )).run_id AS run_id
    FROM created
)
SELECT run_id FROM started;</sql>
    <limit>0</limit>
    <lookup>Get run ID</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI><xloc>368</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Run initialized</name>
    <type>Dummy</type>
    <description>El control rechazará UUID duplicados, cierres y roles no autorizados antes de leer Jachasun</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
    <GUI><xloc>624</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
