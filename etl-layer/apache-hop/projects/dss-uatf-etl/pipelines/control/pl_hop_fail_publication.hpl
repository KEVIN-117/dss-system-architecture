<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_hop_fail_publication</name><name_sync_with_filename>Y</name_sync_with_filename>
    <description>Audita el fallo de publicación y termina el intento sin alterar el DW anterior</description>
    <extended_description>Se ejecuta solo si la sentencia transaccional del publisher falla. Registra un error saneado, el paso FALLIDO y el estado FALLIDA mediante funciones controladas; el token/lease de la sentencia revertida tampoco queda persistido.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters><parameter><name>P_RUN_ID</name><default_value/><description>UUID del intento fallido</description></parameter></parameters>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user><created_date>2026/10/04 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/04 00:00:00.000</modified_date>
  </info>
  <notepads/><order><hop><from>Get run ID</from><to>Audit publication failure</to><enabled>Y</enabled></hop><hop><from>Audit publication failure</from><to>Failure audited</to><enabled>Y</enabled></hop></order>
  <transform>
    <name>Get run ID</name><type>GetVariable</type><description>UUID enlazado de forma preparada</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field></fields><attributes/><GUI><xloc>128</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Audit publication failure</name><type>TableInput</type><description>Solo registra metadatos operativos sin incluir datos personales ni secretos</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>DSS DW</connection>
    <sql>SELECT (etl_control.abort_hop_publication(
    ?::uuid, NULL::uuid,
    'Hop no completó la publicación atómica; se revierte el intento y se limpia el landing'::text
)).run_id AS run_id;</sql>
    <limit>0</limit><lookup>Get run ID</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>432</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform><name>Failure audited</name><type>Dummy</type><description>Confirmación de que la ruta saneada de fallo dejó la ejecución FALLIDA</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><attributes/><GUI><xloc>752</xloc><yloc>160</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>
