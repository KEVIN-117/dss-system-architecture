<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_source_alumnos_vertical</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Valida, extrae y audita el snapshot de academico.alumnos</description>
    <extended_description>Lectura OLTP de solo lectura; no conserva filas personales ni escribe en dimensiones/hechos. id_alumno es la clave primaria contractual; id_ra puede ser nulo.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters><parameter><name>P_RUN_ID</name><default_value/><description>UUID del intento inicializado</description></parameter></parameters>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user><created_date>2026/10/04 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/04 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Validate alumnos contract</from><to>Hash observed schema</to><enabled>Y</enabled></hop>
    <hop><from>Hash observed schema</from><to>Contract accepted?</to><enabled>Y</enabled></hop>
    <hop><from>Contract accepted?</from><to>Abort invalid contract</to><enabled>Y</enabled></hop>
    <hop><from>Contract accepted?</from><to>Keep schema checksum</to><enabled>Y</enabled></hop>
    <hop><from>Keep schema checksum</from><to>Read alumnos snapshot</to><enabled>Y</enabled></hop>
    <hop><from>Read alumnos snapshot</from><to>Count rows</to><enabled>Y</enabled></hop>
    <hop><from>Count rows</from><to>Get run ID</to><enabled>Y</enabled></hop>
    <hop><from>Get run ID</from><to>Audit parameters</to><enabled>Y</enabled></hop>
    <hop><from>Audit parameters</from><to>Register source audit</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Validate alumnos contract</name><type>TableInput</type><description>Projection, tipos, nulabilidad, PK y nulos obligatorios</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection>
    <sql>WITH expected(ordinal_position, column_name, allowed_udt, char_length, is_nullable) AS (
    VALUES
        (1, 'id_alumno',       ARRAY['int4']::text[], NULL::integer, 'NO'::text),
        (2, 'id_programa',     ARRAY['bpchar']::text[], 3::integer, 'NO'::text),
        (3, 'id_ra',           ARRAY['varchar']::text[], 10::integer, 'YES'::text),
        (4, 'fec_inscripcion', ARRAY['date']::text[], NULL::integer, 'NO'::text),
        (5, 'fec_egreso',      ARRAY['date']::text[], NULL::integer, 'YES'::text),
        (6, 'id_plan',          ARRAY['int2']::text[], NULL::integer, 'YES'::text),
        (7, 'estado',           ARRAY['bpchar']::text[], 1::integer, 'NO'::text),
        (8, 'tipo_alumno',      ARRAY['bpchar']::text[], 1::integer, 'NO'::text),
        (9, '_fecha_registro',  ARRAY['timestamp']::text[], NULL::integer, 'YES'::text)
), observed AS (
    SELECT e.ordinal_position, e.column_name, e.allowed_udt, e.char_length, e.is_nullable,
           c.column_name AS actual_name, c.udt_name, c.character_maximum_length,
           c.is_nullable AS actual_nullable
    FROM expected e
    LEFT JOIN information_schema.columns c
      ON c.table_schema = 'academico' AND c.table_name = 'alumnos'
     AND c.column_name = e.column_name
), signature AS (
    SELECT string_agg(
        concat_ws(':', column_name, coalesce(udt_name, '&lt;missing&gt;'),
                  coalesce(character_maximum_length::text, ''), coalesce(actual_nullable, '&lt;missing&gt;')),
        E'\n' ORDER BY ordinal_position
    ) AS value
    FROM observed
)
SELECT CASE WHEN
    NOT EXISTS (
        SELECT 1 FROM observed
        WHERE actual_name IS NULL
           OR NOT (udt_name = ANY(allowed_udt))
           OR character_maximum_length IS DISTINCT FROM char_length
           OR actual_nullable &lt;&gt; is_nullable
    )
    AND EXISTS (
        SELECT 1 FROM pg_constraint c
        WHERE c.conrelid = 'academico.alumnos'::regclass AND c.contype = 'p'
          AND c.conkey = ARRAY[(SELECT a.attnum FROM pg_attribute a
                                WHERE a.attrelid = c.conrelid AND a.attname = 'id_alumno'
                                  AND NOT a.attisdropped)]::smallint[]
    )
    AND NOT EXISTS (SELECT 1 FROM academico.alumnos WHERE id_alumno IS NULL OR id_programa IS NULL
                    OR fec_inscripcion IS NULL OR estado IS NULL OR tipo_alumno IS NULL)
    THEN 1 ELSE 0 END AS contract_ok, signature.value AS schema_signature
FROM signature;</sql>
    <limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>128</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Hash observed schema</name><type>CheckSum</type><description>Hash SHA-256 de la firma real observada</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><checksumtype>SHA-256</checksumtype><resultfieldName>schema_sha256</resultfieldName><resultType>hexadecimal</resultType><fields><field><name>schema_signature</name></field></fields><attributes/><GUI><xloc>384</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Contract accepted?</name><type>FilterRows</type><description>Rechaza un esquema o calidad obligatoria incompatible</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <compare><condition><conditions/><function>=</function><leftvalue>contract_ok</leftvalue><negated>N</negated><operator>-</operator><value><isnull>N</isnull><length>-1</length><mask>####0;-####0</mask><name>constant</name><precision>0</precision><text>1</text><type>Integer</type></value></condition></compare>
    <send_false_to>Abort invalid contract</send_false_to><send_true_to>Keep schema checksum</send_true_to><attributes/><GUI><xloc>640</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Abort invalid contract</name><type>Abort</type><description>Bloquea la fuente antes de leer el snapshot</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><abort_option>ABORT_WITH_ERROR</abort_option><always_log_rows>N</always_log_rows><message>El contrato academico.alumnos no coincide con el esquema aprobado o contiene nulos obligatorios</message><row_threshold>0</row_threshold><attributes/><GUI><xloc>896</xloc><yloc>32</yloc></GUI>
  </transform>
  <transform>
    <name>Keep schema checksum</name><type>SelectValues</type><description>Conserva únicamente el checksum antes de leer datos</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>schema_sha256</name><length>-2</length><precision>-2</precision></field><select_unspecified>N</select_unspecified></fields><attributes/><GUI><xloc>896</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform>
    <name>Read alumnos snapshot</name><type>TableInput</type><description>Snapshot completo con selección explícita y orden estable</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection>
    <sql>SELECT
    id_alumno,
    id_programa,
    id_ra,
    fec_inscripcion,
    fec_egreso,
    id_plan,
    estado,
    tipo_alumno,
    _fecha_registro,
    ?::char(64) AS source_schema_sha256
FROM academico.alumnos
ORDER BY id_alumno ASC;</sql>
    <limit>0</limit><lookup>Keep schema checksum</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>1152</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform>
    <name>Count rows</name><type>GroupBy</type><description>Cuenta filas y elimina el stream con atributos personales para auditoría</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><add_linenr>N</add_linenr><all_rows>N</all_rows><directory>${java.io.tmpdir}</directory><fields><field><aggregate>record_count</aggregate><subject/><type>COUNT_ANY</type><valuefield/></field></fields><give_back_row>Y</give_back_row><group><field><name>source_schema_sha256</name></field></group><ignore_aggregate>N</ignore_aggregate><prefix>grp</prefix><attributes/><GUI><xloc>1408</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform>
    <name>Get run ID</name><type>GetVariable</type><description>Adjunta el UUID de ejecución para auditoría</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field></fields><attributes/><GUI><xloc>1664</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform>
    <name>Audit parameters</name><type>SelectValues</type><description>Solo run_id, checksum de esquema y conteo llegan al control</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><name>run_id</name><length>-2</length><precision>-2</precision></field><field><name>source_schema_sha256</name><rename>schema_sha256</rename><length>-2</length><precision>-2</precision></field><field><name>record_count</name><length>-2</length><precision>-2</precision></field><select_unspecified>N</select_unspecified></fields><attributes/><GUI><xloc>1920</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform>
    <name>Register source audit</name><type>TableInput</type><description>Manifiesto, métrica y paso se confirman de manera auditable</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>DSS DW</connection>
    <sql>WITH params AS MATERIALIZED (
    SELECT ?::uuid AS run_id, ?::char(64) AS schema_sha256, ?::bigint AS record_count
), registered_manifest AS (
    SELECT (etl_control.register_etl_source_manifest(
        p.run_id, 'academico.alumnos'::varchar(150), 'DW-001/v1'::varchar(64),
        'academico'::varchar(63), 'alumnos'::varchar(63),
        '9bfd57a5fab36ac19e6c20cb49495effbc85434d8e1c1570e6fbc907ef1923f8'::char(64), 'id_alumno ASC'::text,
        'COMPLETO'::varchar(16), p.schema_sha256,
        NULL::smallint, NULL::smallint, NULL::timestamptz, p.record_count,
        '{"engine":"apache-hop","source_rows_retained":false,"source_query_file":"pipelines/source/sql/select_alumnos.sql"}'::jsonb
    )).manifest_id AS manifest_id
    FROM params p
), registered_metric AS (
    SELECT (etl_control.record_etl_execution_metric(
        p.run_id, 'source_rows_observed'::varchar(100), p.record_count::numeric,
        'ROWS'::varchar(32), NULL::bigint,
        '{"source_contract_id":"academico.alumnos"}'::jsonb
    )).metric_id AS metric_id
    FROM params p CROSS JOIN registered_manifest
), registered_step AS (
    SELECT (etl_control.register_etl_execution_step(
        p.run_id, 'source_alumnos'::varchar(100), 'EXTRACCION'::varchar(20),
        'EXITOSO'::varchar(16), 2::smallint,
        'pipelines/source/pl_source_alumnos_vertical.hpl'::text,
        'hop-mvp-source-v1'::varchar(255),
        jsonb_build_object('record_count', p.record_count, 'source_rows_retained', false)
    )).step_id AS step_id
    FROM params p CROSS JOIN registered_manifest CROSS JOIN registered_metric
)
SELECT step_id FROM registered_step;</sql>
    <limit>0</limit><lookup>Audit parameters</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>2176</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform_error_handling/><attributes/>
</pipeline>
