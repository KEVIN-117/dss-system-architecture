<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version>1.0</pipeline_version>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>P_RUN_ID</name>
        <description>UUID del intento iniciado por el workflow</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>pl_source_programas_vertical</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Valida, extrae y audita el snapshot academico.alm_programas</description>
    <extended_description>Lectura de solo lectura; no retiene filas ni escribe directamente en DW. Fuente asociada al contrato DW-001/v1.</extended_description>
    <created_user>DSA</created_user>
    <modified_user>DSA</modified_user>
    <created_date>2026/10/04 00:00:00.000</created_date>
    <modified_date>2026/10/04 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Validate contract</name>
    <sql>WITH expected(ordinal_position,column_name,udt_name,char_length,is_nullable) AS (
    VALUES
        (1, 'id_programa', 'bpchar', 3, 'NO'),
        (2, 'programa', 'varchar', 50, 'NO'),
        (3, 'id_facultad', 'int2', NULL, 'NO'),
        (4, 'id_nivel', 'int2', NULL, 'NO'),
        (5, 'nivel', 'varchar', 45, 'YES'),
        (6, 'sede', 'varchar', 1, 'YES'),
        (7, '_tipo_academico', 'bpchar', 3, 'NO'),
        (8, 'activo', 'varchar', NULL, 'YES')
), observed AS (
    SELECT e.*, c.column_name AS actual_name, c.udt_name AS actual_udt,
           c.character_maximum_length AS actual_length, c.is_nullable AS actual_nullable
    FROM expected e LEFT JOIN information_schema.columns c
      ON c.table_schema='academico' AND c.table_name='alm_programas' AND c.column_name=e.column_name
), signature AS (
    SELECT string_agg(concat_ws(':',column_name,coalesce(actual_udt,'&lt;missing>'),
        coalesce(actual_length::text,''),coalesce(actual_nullable,'&lt;missing>')), E'\n' ORDER BY ordinal_position) AS value
    FROM observed
)
SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM observed WHERE actual_name IS NULL OR actual_udt &lt;&gt; udt_name
       OR actual_length IS DISTINCT FROM char_length OR actual_nullable &lt;&gt; is_nullable
) AND NOT EXISTS (SELECT 1 FROM academico.alm_programas WHERE id_programa IS NULL OR programa IS NULL OR id_facultad IS NULL OR _tipo_academico IS NULL)
AND EXISTS (
        SELECT 1 FROM pg_constraint c WHERE c.conrelid = 'academico.alm_programas'::regclass AND c.contype='p'
          AND c.conkey = ARRAY[(SELECT a.attnum FROM pg_attribute a WHERE a.attrelid=c.conrelid AND a.attname='id_programa' AND NOT a.attisdropped)]::smallint[]
    )
THEN 1 ELSE 0 END AS contract_ok,
signature.value AS schema_signature,
NULL::smallint AS p_filter_gestion,
NULL::smallint AS p_gestion,
NULL::smallint AS p_periodo
FROM signature</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>OLTP db</connection>
    <lookup/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Verifica presencia, tipos, longitudes, nulabilidad, clave y datos obligatorios</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>CheckSum</type>
    <name>Hash observed schema</name>
    <fields>
      <field>
        <name>schema_signature</name>
      </field>
    </fields>
    <resultfieldName>schema_sha256</resultfieldName>
    <checksumtype>SHA-256</checksumtype>
    <resultType>hexadecimal</resultType>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>192</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>SHA-256 de la firma observada</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Contract accepted?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>contract_ok</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>####0;-####0</mask>
        </value>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Keep audit fields</send_true_to>
    <send_false_to>Abort invalid contract</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Bloquea la lectura si la fuente incumple el contrato</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Abort invalid contract</name>
    <row_threshold>0</row_threshold>
    <message>El contrato academico.alm_programas no coincide o contiene datos inválidos</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Interrumpe antes de leer el snapshot</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Keep audit fields</name>
    <fields>
      <field>
        <name>schema_sha256</name>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>176</yloc>
    </GUI>
    <description>Conserva solamente parámetros de consulta y hash de esquema</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read source snapshot</name>
    <sql>-- Contract 04 v1: approved active academic-program filter.
SELECT
    id_programa,
    programa,
    id_facultad,
    id_nivel,
    nivel,
    sede,
    _tipo_academico,
    activo,
    ?::char(64) AS source_schema_sha256
FROM academico.alm_programas
WHERE upper(btrim(_tipo_academico)) IN ('CAR', 'PRO', 'TES', 'TEM')
  AND upper(btrim(coalesce(activo, ''))) IN ('1', 'S', 'Y')
ORDER BY id_programa ASC</sql>
    <limit>0</limit>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <connection>OLTP db</connection>
    <lookup>Keep audit fields</lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Consulta contractualmente ordenada, parametrizada y read-only</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GroupBy</type>
    <name>Count rows</name>
    <all_rows>N</all_rows>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <ignore_aggregate>N</ignore_aggregate>
    <group>
      <field>
        <name>source_schema_sha256</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>record_count</aggregate>
        <subject/>
        <type>COUNT_ANY</type>
        <valuefield/>
      </field>
    </fields>
    <add_linenr>N</add_linenr>
    <give_back_row>Y</give_back_row>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>768</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Cuenta sin enviar datos personales a etl_control</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Get run ID</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${P_RUN_ID}</variable>
        <type>String</type>
        <format/>
        <length>36</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>912</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Obtiene el UUID para auditoría</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Audit parameters</name>
    <fields>
      <field>
        <name>run_id</name>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>source_schema_sha256</name>
        <rename>schema_sha256</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>record_count</name>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1056</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Solo UUID, hash y conteo llegan a la auditoría</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Register source audit</name>
    <sql>WITH params AS MATERIALIZED (
    SELECT ?::uuid AS run_id, ?::char(64) AS schema_sha256, ?::bigint AS record_count
), registered_manifest AS (
    SELECT (etl_control.register_etl_source_manifest(
        p.run_id, 'academico.alm_programas'::varchar(150), 'DW-001/v3'::varchar(64),
        'academico'::varchar(63), 'alm_programas'::varchar(63),
        'e8884b33c49c4a58bf3314cfe0026a6539a9261354290e3a6321c79b2cdccaee'::char(64), 'id_programa ASC'::text,
        'COMPLETO'::varchar(16), p.schema_sha256,
        NULL::smallint, NULL::smallint, NULL::timestamptz, p.record_count,
        '{"engine":"apache-hop","source_rows_retained":false,"source_query_file":"pipelines/source/sql/select_programas.sql"}'::jsonb
    )).manifest_id AS manifest_id FROM params p
), metric AS (
    SELECT (etl_control.record_etl_execution_metric(
        p.run_id,'source_rows_observed'::varchar(100),p.record_count::numeric,
        'ROWS'::varchar(32),NULL::bigint,'{"source_contract_id":"academico.alm_programas"}'::jsonb
    )).metric_id AS metric_id FROM params p CROSS JOIN registered_manifest
), step AS (
    SELECT (etl_control.register_etl_execution_step(
        p.run_id,'source_programas'::varchar(100),'EXTRACCION'::varchar(20),
        'EXITOSO'::varchar(16),4::smallint,
        'pipelines/source/pl_source_programas_vertical.hpl'::text,
        'hop-mvp-source-v1'::varchar(255),
        jsonb_build_object('record_count',p.record_count,'source_rows_retained',false)
    )).step_id AS step_id FROM params p CROSS JOIN registered_manifest CROSS JOIN metric
)
SELECT step_id FROM step</sql>
    <limit>0</limit>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DSS DW</connection>
    <lookup>Audit parameters</lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1200</xloc>
      <yloc>48</yloc>
    </GUI>
    <description>Registra manifiesto, métrica y paso mediante API de control</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Validate contract</from>
      <to>Hash observed schema</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hash observed schema</from>
      <to>Contract accepted?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Contract accepted?</from>
      <to>Abort invalid contract</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Contract accepted?</from>
      <to>Keep audit fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keep audit fields</from>
      <to>Read source snapshot</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read source snapshot</from>
      <to>Count rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count rows</from>
      <to>Get run ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get run ID</from>
      <to>Audit parameters</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Audit parameters</from>
      <to>Register source audit</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
