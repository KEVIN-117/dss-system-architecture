<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_fact_retencion_desercion_mvp</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Prepara FACT_RETENCION_DESERCION desde el lote privado FACT_CURSADO</description>
    <extended_description>Grano: estudiante, programa y periodo cerrado. Retenido requiere cursado en el siguiente cierre DSA procesado; desertor requiere menos de dos parciales rendidos y ausencia de cursado en ese siguiente cierre. Sin cierre posterior procesado o con evidencia de egreso al corte, el resultado es NO_EVALUABLE. PPA y materias arrastradas permanecen NULL hasta aprobación de sus fórmulas.</extended_description>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter><name>P_RUN_ID</name><default_value/><description>UUID de la ejecución activa</description></parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user><created_date>2026/10/09 00:00:00.000</created_date>
    <modified_user>DSA</modified_user><modified_date>2026/10/09 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Get run ID</from><to>Prepare and seal FACT_RETENCION_DESERCION</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Get run ID</name><type>GetVariable</type>
    <description>Enlaza el UUID como parámetro JDBC, no como interpolación SQL</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field>
    </fields><attributes/><GUI><xloc>128</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Prepare and seal FACT_RETENCION_DESERCION</name><type>TableInput</type>
    <description>Prepara el snapshot y sella el lote en una misma transacción PostgreSQL</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>DSS DW</connection>
    <sql>SELECT etl_control.prepare_and_complete_hop_fact_retention(?::uuid) AS prepared_rows</sql>
    <limit>0</limit><lookup>Get run ID</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active>
    <attributes/><GUI><xloc>448</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform_error_handling/><attributes/>
</pipeline>
