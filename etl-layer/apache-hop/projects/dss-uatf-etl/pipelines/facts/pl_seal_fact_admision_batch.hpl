<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>pl_seal_fact_admision_batch</name><name_sync_with_filename>Y</name_sync_with_filename><description>Sella FACT_ADMISION tras confirmar el pipeline de staging</description><extended_description>Debe ejecutarse como acción posterior a pl_fact_admision_mvp.hpl. El límite entre acciones garantiza que las filas privadas están confirmadas antes de contarlas y sellarlas.</extended_description><pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type><parameters><parameter><name>P_RUN_ID</name><default_value/><description>UUID de la ejecución activa</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>DSA</created_user><created_date>2026/10/10 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/10 00:00:00.000</modified_date></info>
  <notepads/><order><hop><from>Get run ID</from><to>Seal FACT_ADMISION batch</to><enabled>Y</enabled></hop></order>
  <transform><name>Get run ID</name><type>GetVariable</type><description>Lee el UUID de la ejecución del workflow</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field></fields><attributes/><GUI><xloc>128</xloc><yloc>128</yloc></GUI></transform>
  <transform><name>Seal FACT_ADMISION batch</name><type>TableInput</type><description>Cuenta filas ya confirmadas y sella el lote de forma transaccional</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>DSS DW</connection><sql>SELECT etl_control.seal_hop_fact_admission_batch(?::uuid) AS prepared_rows</sql><limit>0</limit><lookup>Get run ID</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>448</xloc><yloc>128</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>
