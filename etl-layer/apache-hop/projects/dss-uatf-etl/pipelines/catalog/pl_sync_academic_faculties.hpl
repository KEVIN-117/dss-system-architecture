<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_sync_academic_faculties</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Valida y aplica upsert del catálogo completo de facultades en Auth Service</description>
    <extended_description>La fuente académica es la autoridad. No elimina filas. estado se conserva como source_status; su semántica operativa no está definida por el contrato, por lo que no se usa para desactivar facultades.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user><created_date>2026/10/11 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/11 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Validate source contract</from><to>Contract accepted?</to><enabled>Y</enabled></hop>
    <hop><from>Contract accepted?</from><to>Abort invalid source</to><enabled>Y</enabled></hop>
    <hop><from>Contract accepted?</from><to>Read faculty snapshot</to><enabled>Y</enabled></hop>
    <hop><from>Read faculty snapshot</from><to>Upsert Auth faculties</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Validate source contract</name><type>TableInput</type><description>Valida columnas, tipos, PK, snapshot no vacío y nombres obligatorios</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection>
    <sql><![CDATA[WITH expected(column_name, udt_name, char_length, is_nullable) AS (
    VALUES
        ('id_facultad', 'int4', NULL::integer, 'NO'),
        ('facultad',    'varchar', 100, 'NO'),
        ('facu_abre',   'varchar', 50, 'YES'),
        ('estado',      'bpchar', 1, 'YES')
), observed AS (
    SELECT e.*, c.column_name AS actual_name, c.udt_name AS actual_udt,
           c.character_maximum_length AS actual_length, c.is_nullable AS actual_nullable
    FROM expected e LEFT JOIN information_schema.columns c
      ON c.table_schema='academico' AND c.table_name='alm_programas_facultades' AND c.column_name=e.column_name
), schema_ok AS (
    SELECT NOT EXISTS (
        SELECT 1 FROM observed
        WHERE actual_name IS NULL OR actual_udt <> udt_name
           OR actual_length IS DISTINCT FROM char_length OR actual_nullable <> is_nullable
    ) AND EXISTS (
        SELECT 1 FROM pg_constraint c
        WHERE c.conrelid='academico.alm_programas_facultades'::regclass AND c.contype='p'
          AND c.conkey=ARRAY[(SELECT a.attnum FROM pg_attribute a WHERE a.attrelid=c.conrelid AND a.attname='id_facultad' AND NOT a.attisdropped)]::smallint[]
    ) AS valid
), data_ok AS (
    SELECT count(*) > 0 AND NOT EXISTS (
        SELECT 1 FROM academico.alm_programas_facultades
        WHERE id_facultad IS NULL OR facultad IS NULL OR btrim(facultad)=''
           OR char_length(btrim(facultad)) > 100
    ) AS valid
    FROM academico.alm_programas_facultades
)
SELECT CASE WHEN schema_ok.valid AND data_ok.valid THEN 1 ELSE 0 END AS contract_ok
FROM schema_ok CROSS JOIN data_ok]]></sql>
    <limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>128</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Contract accepted?</name><type>FilterRows</type><description>Detiene la carga antes de escribir si el snapshot no satisface el contrato</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <compare><condition><conditions/><function>=</function><leftvalue>contract_ok</leftvalue><negated>N</negated><operator>-</operator><value><isnull>N</isnull><length>-1</length><mask>####0;-####0</mask><name>constant</name><precision>0</precision><text>1</text><type>Integer</type></value></condition></compare>
    <send_false_to>Abort invalid source</send_false_to><send_true_to>Read faculty snapshot</send_true_to><attributes/><GUI><xloc>384</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Abort invalid source</name><type>Abort</type><description>Impide una carga parcial por fuente incompatible o inválida</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option><always_log_rows>N</always_log_rows><message>El contrato del catálogo de facultades no coincide o contiene datos inválidos</message><row_threshold>0</row_threshold><attributes/><GUI><xloc>640</xloc><yloc>32</yloc></GUI>
  </transform>
  <transform>
    <name>Read faculty snapshot</name><type>TableInput</type><description>Lee todas las facultades en orden estable y normaliza cadenas vacías</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection>
    <sql><![CDATA[SELECT id_facultad AS faculty_id,
       btrim(facultad) AS name,
       nullif(btrim(facu_abre), '') AS abbreviation,
       nullif(btrim(estado), '') AS source_status,
       TRUE AS is_active
FROM academico.alm_programas_facultades
WHERE ? = 1
ORDER BY id_facultad ASC]]></sql>
    <limit>0</limit><lookup>Contract accepted?</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>640</xloc><yloc>224</yloc></GUI>
  </transform>
  <transform>
    <name>Upsert Auth faculties</name><type>TableInput</type><description>Inserta o actualiza por faculty_id; nunca borra filas</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>Auth Service DB</connection>
    <sql><![CDATA[INSERT INTO public.academic_faculties
    (faculty_id, name, abbreviation, source_status, is_active, last_synced_at)
VALUES (?, ?, ?, ?, ?, clock_timestamp())
ON CONFLICT (faculty_id) DO UPDATE SET
    name = EXCLUDED.name,
    abbreviation = EXCLUDED.abbreviation,
    source_status = EXCLUDED.source_status,
    is_active = EXCLUDED.is_active,
    last_synced_at = EXCLUDED.last_synced_at
RETURNING faculty_id]]></sql>
    <limit>0</limit><lookup>Read faculty snapshot</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>896</xloc><yloc>224</yloc></GUI>
  </transform>
  <transform_error_handling/><attributes/>
</pipeline>
