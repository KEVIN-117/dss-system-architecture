<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_sync_academic_programs</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Valida y aplica upsert de programas académicos en Auth Service</description>
    <extended_description>Sincroniza únicamente programas CAR, PRO, TES y TEM activos según el contrato aprobado (S/1/Y). Valores auxiliares o no reconocidos quedan fuera del snapshot y nunca causan borrados ni cambios por ausencia. El upsert de la FK compuesta puede bloquear un cambio de facultad si hay contextos de usuario que lo referencian.</extended_description>
    <pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>DSA</created_user><created_date>2026/10/11 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/11 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Validate source contract</from><to>Contract accepted?</to><enabled>Y</enabled></hop>
    <hop><from>Contract accepted?</from><to>Abort invalid source</to><enabled>Y</enabled></hop>
    <hop><from>Contract accepted?</from><to>Read program snapshot</to><enabled>Y</enabled></hop>
    <hop><from>Read program snapshot</from><to>Upsert Auth programs</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Validate source contract</name><type>TableInput</type><description>Valida esquema, PK, filas activas, longitudes y FK fuente a facultad</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection>
    <sql><![CDATA[WITH expected(column_name, udt_name, char_length, is_nullable) AS (
    VALUES
        ('id_programa', 'bpchar', 3, 'NO'),
        ('programa', 'varchar', NULL::integer, 'NO'),
        ('id_facultad', 'int2', NULL::integer, 'NO'),
        ('id_nivel', 'int2', NULL::integer, 'NO'),
        ('nivel', 'varchar', 45, 'YES'),
        ('sede', 'varchar', 1, 'YES'),
        ('_tipo_academico', 'bpchar', 3, 'NO'),
        ('activo', 'varchar', NULL::integer, 'YES')
), observed AS (
    SELECT e.*, c.column_name AS actual_name, c.udt_name AS actual_udt,
           c.character_maximum_length AS actual_length, c.is_nullable AS actual_nullable
    FROM expected e LEFT JOIN information_schema.columns c
      ON c.table_schema='academico' AND c.table_name='alm_programas' AND c.column_name=e.column_name
), schema_ok AS (
    SELECT NOT EXISTS (
        SELECT 1 FROM observed
        WHERE actual_name IS NULL OR actual_udt <> udt_name
           OR actual_length IS DISTINCT FROM char_length OR actual_nullable <> is_nullable
    ) AND EXISTS (
        SELECT 1 FROM pg_constraint c
        WHERE c.conrelid='academico.alm_programas'::regclass AND c.contype='p'
          AND c.conkey=ARRAY[(SELECT a.attnum FROM pg_attribute a WHERE a.attrelid=c.conrelid AND a.attname='id_programa' AND NOT a.attisdropped)]::smallint[]
    ) AS valid
), relevant AS MATERIALIZED (
    SELECT id_programa, programa, id_facultad, _tipo_academico, activo
    FROM academico.alm_programas
    WHERE upper(btrim(_tipo_academico)) IN ('CAR','PRO','TES','TEM')
      AND upper(btrim(coalesce(activo,''))) IN ('1','S','Y')
), data_ok AS (
    SELECT count(*) > 0 AND NOT EXISTS (
        SELECT 1 FROM relevant p
        WHERE p.id_programa IS NULL OR btrim(p.id_programa)='' OR char_length(btrim(p.id_programa)) <> 3
           OR p.programa IS NULL OR btrim(p.programa)='' OR char_length(btrim(p.programa)) > 255
           OR p.id_facultad IS NULL
           OR NOT EXISTS (SELECT 1 FROM academico.alm_programas_facultades f WHERE f.id_facultad=p.id_facultad)
    ) AS valid
    FROM relevant
)
SELECT CASE WHEN schema_ok.valid AND data_ok.valid THEN 1 ELSE 0 END AS contract_ok
FROM schema_ok CROSS JOIN data_ok]]></sql>
    <limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>128</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Contract accepted?</name><type>FilterRows</type><description>Detiene la carga antes de escribir si el catálogo fuente no satisface el contrato</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <compare><condition><conditions/><function>=</function><leftvalue>contract_ok</leftvalue><negated>N</negated><operator>-</operator><value><isnull>N</isnull><length>-1</length><mask>####0;-####0</mask><name>constant</name><precision>0</precision><text>1</text><type>Integer</type></value></condition></compare>
    <send_false_to>Abort invalid source</send_false_to><send_true_to>Read program snapshot</send_true_to><attributes/><GUI><xloc>384</xloc><yloc>128</yloc></GUI>
  </transform>
  <transform>
    <name>Abort invalid source</name><type>Abort</type><description>Impide upserts si hay programas inválidos, estado no reconocido o facultad huérfana</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <abort_option>ABORT_WITH_ERROR</abort_option><always_log_rows>N</always_log_rows><message>El contrato del catálogo de programas no coincide o contiene filas inválidas</message><row_threshold>0</row_threshold><attributes/><GUI><xloc>640</xloc><yloc>32</yloc></GUI>
  </transform>
  <transform>
    <name>Read program snapshot</name><type>TableInput</type><description>Lee solo CAR/PRO/TES/TEM activos (S/1/Y), el mismo filtro contractual del DW</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection>
    <sql><![CDATA[SELECT btrim(id_programa)::char(3) AS career_id,
       id_facultad::integer AS faculty_id,
       btrim(programa) AS name,
       upper(btrim(activo)) AS source_status,
       TRUE AS is_active
FROM academico.alm_programas
WHERE ? = 1
  AND upper(btrim(_tipo_academico)) IN ('CAR','PRO','TES','TEM')
  AND upper(btrim(coalesce(activo,''))) IN ('1','S','Y')
ORDER BY id_programa ASC]]></sql>
    <limit>0</limit><lookup>Contract accepted?</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>640</xloc><yloc>224</yloc></GUI>
  </transform>
  <transform>
    <name>Upsert Auth programs</name><type>TableInput</type><description>Inserta/actualiza por career_id. La FK impide referencias a facultades no sincronizadas; no borra filas</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>Auth Service DB</connection>
    <sql><![CDATA[INSERT INTO public.academic_programs
    (career_id, faculty_id, name, source_status, is_active, last_synced_at)
VALUES (?::char(3), ?, ?, ?, ?, clock_timestamp())
ON CONFLICT (career_id) DO UPDATE SET
    faculty_id = EXCLUDED.faculty_id,
    name = EXCLUDED.name,
    source_status = EXCLUDED.source_status,
    is_active = EXCLUDED.is_active,
    last_synced_at = EXCLUDED.last_synced_at
RETURNING career_id]]></sql>
    <limit>0</limit><lookup>Read program snapshot</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>896</xloc><yloc>224</yloc></GUI>
  </transform>
  <transform_error_handling/><attributes/>
</pipeline>
