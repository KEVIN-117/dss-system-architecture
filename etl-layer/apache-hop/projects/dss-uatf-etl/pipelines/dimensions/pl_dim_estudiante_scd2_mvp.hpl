<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><name>pl_dim_estudiante_scd2_mvp</name><name_sync_with_filename>Y</name_sync_with_filename><description>Prepara cambios SCD2 de estudiante para publicación atómica</description><extended_description>Lee el snapshot contractual y catálogos autorizados, resuelve el cierre efectivo, calcula identidad/hash y prepara únicamente CLOSE/INSERT en el landing privado mediante la rutina SECURITY DEFINER.</extended_description><pipeline_version>1.0</pipeline_version><pipeline_type>Normal</pipeline_type><parameters><parameter><name>P_RUN_ID</name><default_value/><description>UUID de ejecución CIERRE_ACADEMICO EN_EJECUCION</description></parameter></parameters><capture_transform_performance>N</capture_transform_performance><transform_performance_capturing_delay>1000</transform_performance_capturing_delay><transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit><created_user>DSA</created_user><created_date>2026/10/04 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/04 00:00:00.000</modified_date></info>
  <notepads/>
  <order>
    <hop><from>Get run ID</from><to>Read student snapshot</to><enabled>Y</enabled></hop>
    <hop><from>Read student snapshot</from><to>Prepare student SCD2 transition</to><enabled>Y</enabled></hop>
    <hop><from>Prepare student SCD2 transition</from><to>Count SCD2 staging</to><enabled>Y</enabled></hop>
    <hop><from>Count SCD2 staging</from><to>Seal DIM_ESTUDIANTE batch</to><enabled>Y</enabled></hop>
  </order>
  <transform><name>Get run ID</name><type>GetVariable</type><description>UUID para parámetros JDBC tipados</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><fields><field><currency/><decimal/><format/><group/><length>36</length><name>run_id</name><precision>-1</precision><trim_type>both</trim_type><type>String</type><variable>${P_RUN_ID}</variable></field></fields><attributes/><GUI><xloc>128</xloc><yloc>160</yloc></GUI></transform>
  <transform><name>Read student snapshot</name><type>TableInput</type><description>Snapshot de alumnos más atributos personales y catálogos aprobados; el fallback permite sellar un lote vacío</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>OLTP db</connection><sql>WITH run AS MATERIALIZED (
    SELECT ?::uuid AS run_id
), student_rows AS MATERIALIZED (
    SELECT jsonb_build_object(
        'id_ra', a.id_ra,
        'id_alumno', a.id_alumno,
        'id_sexo', u.id_sexo,
        'estado_civil', u.estado_civil,
        'nac_pais', u.nac_pais,
        'id_colegio', u.id_colegio,
        'colegio', c.colegio,
        'tipo_colegio', c.tipo,
        'turno_colegio', c.turno,
        'area_colegio', c.area,
        'cod_localidad', u.id_loc,
        'localidad', l.localidad,
        'cod_pais', l.cod_pais,
        'cod_departamento', l.cod_dep,
        'cod_provincia', l.cod_prov,
        'gestion_egreso_colegio', u.egr_gestion,
        'fec_inscripcion', a.fec_inscripcion,
        'fec_egreso', a.fec_egreso,
        'estado_academico', a.estado,
        'tipo_alumno', a.tipo_alumno,
        '_demographic_match', (u.id_ra IS NOT NULL)
    )::text AS student_record
    FROM academico.alumnos a
    LEFT JOIN public.uatf_datos u ON u.id_ra = a.id_ra
    LEFT JOIN public.prs_colegios c ON c.id_colegio = u.id_colegio
    LEFT JOIN public.lugar_localidad l ON l.cod_loc = u.id_loc
    ORDER BY a.id_alumno ASC
)
SELECT r.run_id, s.student_record
FROM run r
LEFT JOIN student_rows s ON TRUE
ORDER BY (s.student_record::jsonb->>'id_alumno')::integer NULLS LAST</sql><limit>0</limit><lookup>Get run ID</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>384</xloc><yloc>160</yloc></GUI></transform>
  <transform><name>Prepare student SCD2 transition</name><type>TableInput</type><description>Compara con la versión actual, bloquea identidades ambiguas y usa solo el API privado de staging</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>DSS DW</connection><sql>WITH p AS MATERIALIZED (
    SELECT ?::uuid AS run_id, ?::jsonb AS student_record
), prepared AS MATERIALIZED (
    SELECT etl_control.prepare_hop_student_scd2(p.run_id, p.student_record) AS staged_rows
    FROM p
)
SELECT p.run_id, p.student_record, prepared.staged_rows
FROM p CROSS JOIN prepared</sql><limit>0</limit><lookup>Read student snapshot</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>704</xloc><yloc>160</yloc></GUI></transform>
  <transform><name>Count SCD2 staging</name><type>GroupBy</type><description>Cuenta observaciones y operaciones CLOSE/INSERT para sellar el lote</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><add_linenr>N</add_linenr><all_rows>N</all_rows><directory>${java.io.tmpdir}</directory><fields>
      <field><aggregate>prepared_rows</aggregate><subject>staged_rows</subject><type>SUM</type><valuefield/></field>
      <field><aggregate>observed_students</aggregate><subject>student_record</subject><type>COUNT_ANY</type><valuefield/></field>
    </fields><give_back_row>Y</give_back_row><group><field><name>run_id</name></field></group><ignore_aggregate>N</ignore_aggregate><prefix>grp</prefix><attributes/><GUI><xloc>992</xloc><yloc>160</yloc></GUI></transform>
  <transform><name>Seal DIM_ESTUDIANTE batch</name><type>TableInput</type><description>Sella lote SCD2 y registra métricas/paso de transformación</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>DSS DW</connection><sql>WITH params AS MATERIALIZED (
    SELECT ?::uuid AS run_id, coalesce(?::bigint, 0) AS prepared_rows,
           coalesce(?::bigint, 0) AS observed_students
), sealed AS MATERIALIZED (
    SELECT (etl_control.seal_hop_publication_batch(
        p.run_id, 'DIM_ESTUDIANTE'::varchar(40), p.prepared_rows
    )).target_code AS target_code
    FROM params p WHERE p.run_id IS NOT NULL
), metric AS MATERIALIZED (
    SELECT (etl_control.record_etl_execution_metric(
        p.run_id, 'student_snapshot_rows'::varchar(100), p.observed_students::numeric,
        'ROWS'::varchar(32), NULL::bigint, '{"dimension":"DIM_ESTUDIANTE"}'::jsonb
    )).metric_id AS metric_id
    FROM params p CROSS JOIN sealed
), step AS (
    SELECT (etl_control.register_etl_execution_step(
        p.run_id, 'dimension_estudiante_scd2'::varchar(100), 'TRANSFORMACION'::varchar(20),
        'EXITOSO'::varchar(16), 25::smallint,
        'pipelines/dimensions/pl_dim_estudiante_scd2_mvp.hpl'::text,
        'hop-mvp-student-scd2-v1'::varchar(255),
        jsonb_build_object('target_code','DIM_ESTUDIANTE','observed_students',p.observed_students,
                           'prepared_operations',p.prepared_rows,'published',false)
    )).step_id AS step_id
    FROM params p CROSS JOIN sealed CROSS JOIN metric
)
SELECT step_id FROM step</sql><limit>0</limit><lookup>Count SCD2 staging</lookup><execute_each_row>Y</execute_each_row><variables_active>N</variables_active><attributes/><GUI><xloc>1280</xloc><yloc>160</yloc></GUI></transform>
  <transform_error_handling/><attributes/>
</pipeline>
