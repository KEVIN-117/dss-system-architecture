<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_hop_publish_staged_run</name><name_sync_with_filename>Y</name_sync_with_filename>
  <description>Publica en forma atómica un run previamente extraído, transformado y validado</description>
  <extended_description>No extrae ni transforma. Requiere nueve manifiestos completos, validación exitosa y ocho lotes preparados y sellados. La ruta de fallo audita y deja FALLIDA; la publicación anterior permanece intacta.</extended_description>
  <workflow_version>1.0</workflow_version><created_user>DSA</created_user><created_date>2026/10/04 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/04 00:00:00.000</modified_date>
  <parameters><parameter><name>P_RUN_ID</name><default_value/><description>UUID único del intento validado</description></parameter></parameters>
  <actions>
    <action><name>Start</name><description/><type>SPECIAL</type><attributes/><DayOfMonth>1</DayOfMonth><doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution><hour>12</hour><intervalMinutes>60</intervalMinutes><intervalSeconds>0</intervalSeconds><minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay><parallel>N</parallel><xloc>64</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>Atomic publish</name><description>Lease, manifiestos, publicación y éxito en una sentencia PostgreSQL</description><type>PIPELINE</type><attributes/><filename>${PROJECT_HOME}/pipelines/control/pl_hop_publish_staged_run.hpl</filename><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><xloc>320</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>Audit failed publish</name><description>Rollback transaccional previo; registra fallo saneado y conserva la publicación anterior</description><type>PIPELINE</type><attributes/><filename>${PROJECT_HOME}/pipelines/control/pl_hop_fail_publication.hpl</filename><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><xloc>608</xloc><yloc>256</yloc><attributes_hac/></action>
    <action><name>Abort workflow after failed publish</name><description>Propaga el fallo al caller aunque la auditoría haya terminado correctamente</description><type>ABORT</type><attributes/><always_log_rows>N</always_log_rows><message>La publicación DW falló; el run quedó auditado FALLIDA y la versión anterior se conserva.</message><parallel>N</parallel><xloc>896</xloc><yloc>256</yloc><attributes_hac/></action>
  </actions>
  <hops><hop><from>Start</from><to>Atomic publish</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop><hop><from>Atomic publish</from><to>Audit failed publish</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop><hop><from>Audit failed publish</from><to>Abort workflow after failed publish</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop></hops>
  <notepads/><attributes/>
</workflow>
