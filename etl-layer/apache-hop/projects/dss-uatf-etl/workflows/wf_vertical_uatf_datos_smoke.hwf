<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_vertical_uatf_datos_smoke</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Flujo vertical controlado de las nueve fuentes DW-001 (solo desarrollo)</description>
  <extended_description>Lee las nueve fuentes, prepara cinco dimensiones y los tres hechos en landing privado, valida manifiestos/lotes y ejecuta el publisher atómico. Solo el commit final hace visible el conjunto completo; cualquier fallo conserva la publicación anterior.</extended_description>
  <created_user>DSA</created_user>
  <modified_user>DSA</modified_user>
  <created_date>2026/10/03 00:00:00.000</created_date>
  <modified_date>2026/10/03 00:00:00.000</modified_date>
  <workflow_version>1.0</workflow_version>
  <parameters>
    <parameter>
      <name>P_RUN_ID</name>
      <description>UUID v4 nuevo por intento; nunca reutilizar un UUID</description>
      <default_value/>
    </parameter>
    <parameter>
      <name>P_REQUESTED_PERIODO</name>
      <description>Código de periodo autorizado de cierre DSA</description>
      <default_value/>
    </parameter>
    <parameter>
      <name>P_REQUESTED_GESTION</name>
      <description>Gestión autorizada de cierre DSA</description>
      <default_value/>
    </parameter>
  </parameters>
