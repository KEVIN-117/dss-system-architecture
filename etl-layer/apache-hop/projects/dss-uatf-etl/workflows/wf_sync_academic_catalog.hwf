<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_sync_academic_catalog</name><name_sync_with_filename>Y</name_sync_with_filename>
  <description>Sincroniza facultades y programas de Jachasun al catálogo de Auth Service</description>
  <extended_description>Valida cada snapshot antes de aplicar upserts. Carga primero facultades para satisfacer la FK de programas. Las filas ausentes no se eliminan; programas marcados N se conservan y se actualizan como inactivos. La ejecución es repetible; si falla después de facultades, volver a ejecutarla completa converge el catálogo.</extended_description>
  <workflow_version>1.0</workflow_version><created_user>DSA</created_user><created_date>2026/10/11 00:00:00.000</created_date><modified_user>DSA</modified_user><modified_date>2026/10/11 00:00:00.000</modified_date>
  <parameters/>
  <actions>
    <action><name>Start</name><description/><type>SPECIAL</type><attributes/><DayOfMonth>1</DayOfMonth><doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution><hour>12</hour><intervalMinutes>60</intervalMinutes><intervalSeconds>0</intervalSeconds><minutes>0</minutes><repeat>N</repeat><schedulerType>0</schedulerType><weekDay>1</weekDay><parallel>N</parallel><xloc>64</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>Sync faculties</name><description>Valida y hace upsert del catálogo fuente completo de facultades</description><type>PIPELINE</type><attributes/><filename>${PROJECT_HOME}/pipelines/catalog/pl_sync_academic_faculties.hpl</filename><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><xloc>352</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>Sync programs</name><description>Valida y hace upsert de programas, tras completar las facultades</description><type>PIPELINE</type><attributes/><filename>${PROJECT_HOME}/pipelines/catalog/pl_sync_academic_programs.hpl</filename><params_from_previous>N</params_from_previous><exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files><set_logfile>N</set_logfile><logfile/><logext/><add_date>N</add_date><add_time>N</add_time><loglevel>Basic</loglevel><set_append_logfile>N</set_append_logfile><wait_until_finished>Y</wait_until_finished><create_parent_folder>N</create_parent_folder><run_configuration>local</run_configuration><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><parallel>N</parallel><xloc>640</xloc><yloc>160</yloc><attributes_hac/></action>
    <action><name>Abort after failed sync</name><description>Propaga el fallo al caller para que Hop informe el workflow como fallido</description><type>ABORT</type><attributes/><always_log_rows>N</always_log_rows><message>La sincronización del catálogo académico falló; vuelve a ejecutar el workflow tras resolver la causa</message><parallel>N</parallel><xloc>640</xloc><yloc>288</yloc><attributes_hac/></action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Sync faculties</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Sync faculties</from><to>Sync programs</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Sync faculties</from><to>Abort after failed sync</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Sync programs</from><to>Abort after failed sync</to><enabled>Y</enabled><evaluation>N</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads/><attributes/>
</workflow>
