# Copy to dw-control-service.uatf.env on the deployment host and protect it
# with filesystem permissions. Never commit the populated file.

# PostgreSQL DW endpoint and dedicated login. The account must inherit only
# dw_control_service; do not use dw_owner, dw_control_operator, or a migrator.
DW_CONTROL_DB_URL=jdbc:postgresql://postgres-dw:5432/dss_dw
DW_CONTROL_DB_USERNAME=dw_control_runtime
DW_CONTROL_DB_PASSWORD=REPLACE_WITH_SECRET
DW_CONTROL_DB_POOL_SIZE=8
DW_CONTROL_DB_CONNECTION_TIMEOUT_MS=5000

# Issuer must exactly match the JWT iss claim. JWK Set endpoint must be
# reachable from this container; an internal Keycloak URL is preferred.
KEYCLOAK_ISSUER_URI=https://sso.example.uatf.edu.bo/realms/uatf-dss-realm
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/uatf-dss-realm/protocol/openid-connect/certs
KEYCLOAK_DW_CONTROL_AUDIENCE=dw-control-service
KEYCLOAK_DW_CONTROL_CLIENT_ID=dw-control-service
