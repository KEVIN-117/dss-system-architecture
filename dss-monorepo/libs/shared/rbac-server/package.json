{
  "name": "@dss-monorepo/rbac-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dss-monorepo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "@dss-monorepo/source": "./src/permissions.ts",
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.js",
      "default": "./dist/permissions.js"
    },
    "./permission-map": {
      "@dss-monorepo/source": "./src/permission-map.ts",
      "types": "./dist/permission-map.d.ts",
      "import": "./dist/permission-map.js",
      "default": "./dist/permission-map.js"
    },
    "./middleware": {
      "@dss-monorepo/source": "./src/middleware.ts",
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    }
  },
  "nx": {
    "tags": ["type:domain", "scope:shared"]
  },
  "dependencies": {
    "@dss-monorepo/auth-models": "workspace:*"
  }
}
