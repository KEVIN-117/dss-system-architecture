{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@dss-monorepo/olap-models": ["../olap-models/src/index.ts"],
      "@dss-monorepo/olap-connector": [
        "../../connectors/olap-connector/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../olap-models/tsconfig.lib.json"
    },
    {
      "path": "../../connectors/olap-connector/tsconfig.lib.json"
    }
  ]
}
