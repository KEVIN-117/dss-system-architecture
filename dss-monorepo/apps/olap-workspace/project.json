{
  "name": "@dss-monorepo/olap-workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/olap-workspace/src",
  "tags": ["type:app", "scope:olap"],
  "targets": {
    "build": {
      "command": "next build --webpack",
      "parallelism": false,
      "options": {
        "cwd": "apps/olap-workspace",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "dev": {
      "command": "next dev --webpack",
      "options": {
        "port": 3007,
        "cwd": "apps/olap-workspace"
      }
    },
    "serve": {
      "options": {
        "port": 3007
      }
    }
  }
}
