{
  "name": "@dss-monorepo/docs-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs-portal/src",
  "tags": ["type:app", "scope:shared"],
  "targets": {
    "sync-openapi": {
      "command": "node scripts/sync-openapi.mjs",
      "options": {
        "cwd": "apps/docs-portal"
      },
      "cache": false
    },
    "check-openapi": {
      "command": "node scripts/sync-openapi.mjs --check",
      "options": {
        "cwd": "apps/docs-portal"
      },
      "cache": false
    },
    "build": {
      "command": "next build --webpack",
      "dependsOn": ["^build", "sync-openapi"],
      "parallelism": false,
      "options": {
        "cwd": "apps/docs-portal",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "dev": {
      "dependsOn": ["sync-openapi"],
      "options": {
        "port": 3005
      }
    },
    "serve": {
      "options": {
        "port": 3005
      }
    }
  }
}
