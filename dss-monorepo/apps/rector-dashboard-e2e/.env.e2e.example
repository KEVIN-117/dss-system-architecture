RECTOR_DASHBOARD_PORT_E2E=3004
RECTOR_DASHBOARD_BASE_URL=http://localhost:3004
NEXT_PUBLIC_BFF_URL=http://localhost:3006
BFF_PORT_E2E=3006
BFF_BASE_URL=http://localhost:3006
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=uatf-dss-realm
KEYCLOAK_AUDIENCE=uatf-auth-service
KEYCLOAK_ROLE_CLIENT_ID=uatf-auth-service
KEYCLOAK_BFF_CLIENT_ID=dss-bff
# KEYCLOAK_BFF_CLIENT_SECRET is loaded from apps/bff/.env.
KEYCLOAK_BFF_REDIRECT_URI=http://localhost:3006/api/auth/callback
KEYCLOAK_BFF_POST_LOGOUT_REDIRECT_URI=http://localhost:3004/login
AUTH_SERVICE_URL=http://localhost:8000
BFF_ALLOWED_ORIGINS=http://localhost:3004
BFF_DEFAULT_POST_LOGIN_REDIRECT_URI=http://localhost:3004/
BFF_SESSION_SECRET=e2e-session-secret-not-used-in-production-123456
BFF_SESSION_TTL_SECONDS=300
BFF_SESSION_COOKIE=dss_session

# The BFF host process talks to this isolated API container.
PREDICTION_SERVICE_URL=http://localhost:18007

# Select a processed Faker program/cut. Bundle and publication state are
# prepared in temporary Docker volumes by run_prediction_bff_ui_e2e.ps1.
PREDICTION_E2E_PROGRAM_REF=
PREDICTION_E2E_CUT_ID=

# Pre-provision local Keycloak/Auth Service users. Rector must have role RECTOR.
# The second account must be DIRECTOR with a career context excluding this program.
PREDICTION_E2E_RECTOR_USERNAME=
PREDICTION_E2E_RECTOR_PASSWORD=
PREDICTION_E2E_OUT_OF_SCOPE_USERNAME=
PREDICTION_E2E_OUT_OF_SCOPE_PASSWORD=
