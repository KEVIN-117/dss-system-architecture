{
  "name": "@dss-monorepo/director-dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/director-dashboard/src",
  "tags": ["type:app", "scope:director"],
  "targets": {
    "build": {
      "command": "next build --webpack",
      "parallelism": false,
      "options": {
        "cwd": "apps/director-dashboard",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "dev": {
      "options": {
        "port": 3003
      }
    },
    "serve": {
      "options": {
        "port": 3003
      }
    }
  }
}
