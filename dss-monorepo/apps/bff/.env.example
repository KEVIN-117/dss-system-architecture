BFF_PORT=

# ── Keycloak (solo servidor) ──────────────────────────
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_AUDIENCE=uatf-auth-service
KEYCLOAK_ROLE_CLIENT_ID=uatf-auth-service
# Confidential client used only by the BFF's Authorization Code callback.
KEYCLOAK_BFF_CLIENT_ID=dss-bff
KEYCLOAK_BFF_CLIENT_SECRET=
KEYCLOAK_BFF_REDIRECT_URI=http://localhost:3006/api/auth/callback
KEYCLOAK_BFF_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# ── Auth service (solo servidor) ──────────────────────
AUTH_SERVICE_URL=
DW_CONTROL_SERVICE_URL=http://localhost:8090
# Optional: 1000-60000 milliseconds, defaults to 15000.
DW_CONTROL_SERVICE_TIMEOUT_MS=15000
OLAP_SERVICE_URL=http://localhost:8088
# Required for DECANO/DIRECTOR analyticQuery. Matches the UATF Mondrian schema
# in infra/olap/schemas/uatf-rendimiento-academico.xml. Keep this JSON in sync
# with the dimension/hierarchy/level names in that schema; it contains no secrets.
OLAP_ACADEMIC_SCOPE_FILTERS='{"faculty":{"dimension":"Academic Faculty Scope","hierarchy":"Faculty Scope","level":"Faculty","memberTemplate":"[Academic Faculty Scope].[Faculty Scope].[Faculty].&[{id}]"},"career":{"dimension":"Academic Career Scope","hierarchy":"Career Scope","level":"Career","memberTemplate":"[Academic Career Scope].[Career Scope].[Career].&[{id}]"}}'
PREDICTION_SERVICE_URL=

# Orígenes de los portales separados por coma. No usar * con Bearer tokens.
BFF_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3007
BFF_DEFAULT_POST_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback
BFF_SESSION_SECRET=
# Optional: 60-900 seconds, defaults to 300.
BFF_SESSION_TTL_SECONDS=300
# Optional cookie name, defaults to dss_session.
BFF_SESSION_COOKIE=dss_session
