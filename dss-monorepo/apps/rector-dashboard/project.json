{
  "name": "@dss-monorepo/rector-dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/rector-dashboard/src",
  "tags": ["type:app", "scope:rector"],
  "targets": {
    "build": {
      "command": "next build --webpack",
      "dependsOn": ["^build"],
      "parallelism": false,
      "options": {
        "cwd": "apps/rector-dashboard",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "dev": {
      "options": {
        "port": 3004
      }
    },
    "serve": {
      "options": {
        "port": 3004
      }
    }
  }
}
