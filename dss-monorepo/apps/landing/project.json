{
  "name": "@dss-monorepo/landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/landing/src",
  "projectType": "application",
  "tags": ["type:app", "scope:public"],
  "// targets": "to see all targets run: nx show project @dss-monorepo/landing --web",
  "targets": {
    "build": {
      "command": "next build --webpack",
      "dependsOn": ["^build"],
      "parallelism": false,
      "options": {
        "cwd": "apps/landing",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "dev": {
      "options": {
        "port": 3000
      }
    },
    "serve": {
      "options": {
        "port": 3000
      }
    }
  }
}
