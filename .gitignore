# ==========================================
# DSS System Architecture - .gitignore
# ==========================================

# ------------------------------------------
# 1. Variables de Entorno y Credenciales
# ------------------------------------------
.env
.env.*
**/.env
**/.env.*
*.env
# Preservar plantillas de ejemplo
!.env.example
!**/.env.example
!**/.env.*.example
!.env.template
!**/.env.template

# Load Manager: local fixture credentials stay untracked; its safe template is versioned.
etl-layer/loadmanager/.env
!etl-layer/loadmanager/.env.example

# Apache Hop: active environment files may contain local endpoints and credentials.
# Keep only sanitized examples in Git; preserve the active files locally.
etl-layer/apache-hop/projects/dss-uatf-etl/environments/dev-env.json
etl-layer/apache-hop/projects/dss-uatf-etl/environments/integration-env.json
etl-layer/apache-hop/projects/dss-uatf-etl/environments/integration-test.json
etl-layer/apache-hop/projects/dss-uatf-etl/environments/prod-env.json
!etl-layer/apache-hop/projects/dss-uatf-etl/environments/dev-env.example.json
!etl-layer/apache-hop/projects/dss-uatf-etl/environments/integration-env.example.json
!etl-layer/apache-hop/projects/dss-uatf-etl/environments/prod-env.example.json

# Certificados, llaves privadas y tokens
*.pem
*.key
*.keystore
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
*.secret
.erlang.cookie

# ------------------------------------------
# 2. Infraestructura, Volúmenes y Bases de Datos
# ------------------------------------------
/infra/postgres-dw/*
!/infra/postgres-dw/.gitkeep
/infra/auth-service-db/*
!/infra/auth-service-db/.gitkeep
/infra/rabbitmq/data/*
!/infra/rabbitmq/data/.gitkeep
/infra/hop/*
!/infra/hop/.gitkeep
/data-layer/neo4j/data/*
!/data-layer/neo4j/data/.gitkeep
/data-layer/neo4j/logs/*
!/data-layer/neo4j/logs/.gitkeep
/data-layer/neo4j/import/*
!/data-layer/neo4j/import/.gitkeep
infra/**/data/*
docker-compose.override.yml

# ------------------------------------------
# Datos fuente / históricos locales (no versionar)
# ------------------------------------------
# Exportaciones OLTP y datasets originales pueden contener datos personales.
# Los fixtures sintéticos aprobados bajo infra/dw-test-data sí se versionan.
/dataset/
**/dataset/
**/data/out_oltp/
**/out_oltp/
**/raw-data/
**/raw_data/
**/data/raw/
*.xlsx
*.xls
*.parquet
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# ------------------------------------------
# 3. Apache Hop & ETL Drivers / Runtime
# ------------------------------------------
**/jdbc/*.jar
**/audit/
**/.hop/
**/hop-audit/
*.hpl.cache
*.hwf.cache

# ------------------------------------------
# 4. Java & Maven (auth-service, keycloak-webhook)
# ------------------------------------------
target/
**/target/
*.class
*.war
*.ear
*.nar
.mvn/timing.properties
.gradle/
**/build/

# Excepción: proveedores jar requeridos por Keycloak
!/infra/keycloak/providers/*.jar

# ------------------------------------------
# 5. Python & Machine Learning (prediction-service)
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/venv/
**/.venv/
env/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.ipynb_checkpoints/
*.pkl
*.joblib

# ------------------------------------------
# 6. Node.js, Frontend & Monorepo (Next.js, Nx, Vite)
# ------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
.nx/cache/
**/.nx/cache/
.nx/workspace-data/
**/.nx/workspace-data/
.nx/migrate-runs/
**/.nx/migrate-runs/
.nx/polygraph/
**/.nx/polygraph/
.turbo/
**/.turbo/
.parcel-cache/
**/.parcel-cache/
storybook-static/
**/storybook-static/
vite.config.*.timestamp*
vitest.config.*.timestamp*
*.tsbuildinfo
**/*.tsbuildinfo
.eslintcache
**/.eslintcache
.stylelintcache
**/.stylelintcache

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
test-output/
**/test-output/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/

# Package managers logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# 7. IDEs, Editores y Asistentes de Código
# ------------------------------------------
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
*.iws
.vscode/
**/.vscode/
.fleet/
**/.fleet/
.history/
**/.history/
*.sublime-workspace
*.sublime-project

# Herramientas de IA y asistentes
.claude/worktrees/
**/.claude/worktrees/
.claude/settings.local.json
**/.claude/settings.local.json
.gemini/
**/.gemini/
.cursor/
**/.cursor/

# ------------------------------------------
# 8. Archivos del Sistema Operativo
# ------------------------------------------
.DS_Store
**/.DS_Store
.DS_Store?
._*
Thumbs.db
**/Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------
# 9. Logs, Respaldos y Archivos Temporales
# ------------------------------------------
# Logs
*.log
**/*.log
*.log.*
logs/
**/logs/

# Temporales y caches generales
*.tmp
**/*.tmp
*.temp
**/*.temp
tmp/
**/tmp/
temp/
**/temp/
.cache/
**/.cache/
*.cache

# Respaldos y archivos de edición temporal
*.bak
**/*.bak
*.backup
**/*.backup
*.old
**/*.old
*.orig
**/*.orig
*.rej
*~
**/*~
*.swp
**/*.swp
*.swo
**/*.swo

# Bloqueos y archivos temporales de Office / Editores
~$*
.~lock.*#
*.pid
*.pid.lock
*.seed
*.dmp
*.stackdump
core
core.*

# ------------------------------------------
# 10. Servicios Legacy / Temporales
# ------------------------------------------
/etl-service
/dss-etl-hop
/saiku-ui