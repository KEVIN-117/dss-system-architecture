# ==========================================
# 1. POSTGRES DATABASES (Data Warehouse & Tx)
# ==========================================
DOCKERHUB_USERNAME=local
AUTH_SERVICE_VERSION=local
KEYCLOAK_VERSION=local
OLAP_SERVICE_VERSION=local
APACHE_HOP_VERSION=local

POSTGRES_DW_USER=admin
POSTGRES_DW_PASSWORD=
POSTGRES_DW_NAME=dss_dw

POSTGRES_TX_USER=postgres
POSTGRES_TX_PASSWORD=
POSTGRES_TX_NAME=jachasun
DB_DW_HOST=host.docker.internal
DB_DW_PORT=5434
DB_TX_HOST=host.docker.internal
DB_TX_PORT=5432
HOP_ENVIRONMENT_NAME=dev
HOP_WEB_PORT=8081

# ==========================================
# 1.1 PREDICTION SERVICE (FastAPI)
# ==========================================
PREDICTION_ENV=development
PREDICTION_PORT=8000
PREDICTION_LOG_LEVEL=info
PREDICTION_RELOAD=false

# ==========================================
# 2. KEYCLOAK (Identity Provider)
# ==========================================
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://auth-service-db:5432/dss_identity
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=
KC_DB_POOL_INITIAL_SIZE=25
KC_DB_POOL_MIN_SIZE=25
KC_DB_POOL_MAX_SIZE=25

# Shared RabbitMQ transport for Keycloak user events and auth-service.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
# Used once during realm import and by the BFF runtime. Keep it outside Git.
KEYCLOAK_BFF_CLIENT_SECRET=

# ==========================================
# 3. AUTH SERVICE (Spring Boot)
# ==========================================
AUTH_DB_USER=admin
AUTH_DB_PASSWORD=
AUTH_DB_NAME=dss_identity

AUTH_SPRING_PROFILE_ACTIVE=dev
AUTH_SERVER_PORT=8000
AUTH_DB_URI=jdbc:postgresql://auth-service-db:5432/dss_identity

# Must match the `iss` claim in Keycloak tokens; JWKS may use the Docker-only hostname below.
AUTH_KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/uatf-dss-realm
AUTH_KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/uatf-dss-realm/protocol/openid-connect/certs
AUTH_KEYCLOAK_RESOURCE_ID=uatf-auth-service
AUTH_KEYCLOAK_PRINCIPAL_ATTRIBUTE=preferred_username
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# ==========================================
# 3.1 OLAP SERVICE (Saiku)
# ==========================================
# Local host port; Keycloak already uses 8080.
OLAP_PORT=8088
OLAP_KEYCLOAK_AUDIENCE=olap-service
OLAP_KEYCLOAK_CLIENT_ID=olap-service
OLAP_DB_USER=dw_olap_runtime
OLAP_DB_PASSWORD=
# Set a strong local password; keep the actual value only in the ignored .env file.
SAIKU_ADMIN_PASSWORD=

# ==========================================
# 3.2 DW CONTROL SERVICE
# ==========================================
DW_CONTROL_PORT=8090
DW_CONTROL_PROFILE=dev
DW_CONTROL_DB_URL=jdbc:postgresql://localhost:5434/dss_dw
DW_CONTROL_DB_USERNAME=dw_control_runtime
DW_CONTROL_DB_PASSWORD=
KEYCLOAK_DW_CONTROL_AUDIENCE=dw-control-service
KEYCLOAK_DW_CONTROL_CLIENT_ID=dw-control-service
DW_CONTROL_OPENAPI_ENABLED=true

# ==========================================
# 4. MESSAGE BROKER (RabbitMQ)
# ==========================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=
