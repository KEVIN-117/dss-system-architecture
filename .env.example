# ==========================================
# 1. POSTGRES DATABASES (Data Warehouse & Tx)
# ==========================================
POSTGRES_DW_USER=admin
POSTGRES_DW_PASSWORD=
POSTGRES_DW_NAME=dss_dw

POSTGRES_TX_USER=postgres
POSTGRES_TX_PASSWORD=
POSTGRES_TX_NAME=jachasun
DB_DW_HOST=host.docker.internal
DB_DW_PORT=5434
DB_TX_HOST=host.docker.internal
DB_TX_PORT=5432
HOP_ENVIRONMENT_NAME=dev
HOP_WEB_PORT=8081

# ==========================================
# 2. KEYCLOAK (Identity Provider)
# ==========================================
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://auth-service-db:5432/dss_identity
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=
KC_DB_POOL_INITIAL_SIZE=25
KC_DB_POOL_MIN_SIZE=25
KC_DB_POOL_MAX_SIZE=25

KEYCLOAK_WEBHOOK_URL=http://auth-service:8000/api/v1/auth/sync
KEYCLOAK_WEBHOOK_SECRET=
# Used once during realm import and by the BFF runtime. Keep it outside Git.
KEYCLOAK_BFF_CLIENT_SECRET=

# ==========================================
# 3. AUTH SERVICE (Spring Boot)
# ==========================================
AUTH_DB_USER=admin
AUTH_DB_PASSWORD=
AUTH_DB_NAME=dss_identity

AUTH_SPRING_PROFILE_ACTIVE=dev
AUTH_SERVER_PORT=8000
AUTH_DB_URI=jdbc:postgresql://auth-service-db:5432/dss_identity

AUTH_KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/uatf-dss-realm
AUTH_KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/uatf-dss-realm/protocol/openid-connect/certs
AUTH_KEYCLOAK_RESOURCE_ID=uatf-auth-service
AUTH_KEYCLOAK_PRINCIPAL_ATTRIBUTE=preferred_username
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# ==========================================
# 4. MESSAGE BROKER (RabbitMQ)
# ==========================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=
