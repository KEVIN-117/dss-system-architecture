# Copy this file to .env and provide real values through your secret manager
# or local environment. Do not commit the resulting .env file.
SPRING_PROFILE_ACTIVE=dev
SERVER_PORT=8000

DB_URI=jdbc:postgresql://localhost:5432/auth_service
DB_USERNAME=postgres
DB_PASSWORD=

KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/uatf-dss
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/uatf-dss/protocol/openid-connect/certs
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
KEYCLOAK_RESOURCE_ID=uatf-auth-service
KEYCLOAK_AUDIENCE=uatf-auth-service
KEYCLOAK_PRINCIPAL_ATTRIBUTE=preferred_username

# Comma-separated browser origins. Required in the production profile.
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
