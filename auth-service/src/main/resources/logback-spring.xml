<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include default Spring Boot configurations for coloring and patterns -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <!-- Dedicated JSON Appender for Audit Logs -->
    <appender name="AUDIT_JSON_APPENDER" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Audit Logger: Will only write to the JSON Appender, ignoring root (additivity=false) -->
    <logger name="AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_JSON_APPENDER" />
    </logger>

    <!-- Root Logger: Writes to standard Spring Boot Console -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
